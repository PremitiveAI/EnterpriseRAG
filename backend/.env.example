# EnterpriseRAG backend — copy to .env and fill in.
# NEVER commit .env. No value here may reach the browser bundle.

APP_NAME=EnterpriseRAG
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/enterprise_rag
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Must be >= 32 chars. Generate: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:3000

# --- Credential encryption (ADR-010) ---
# Encrypts provider API keys stored in the database. Format: "<id>:<secret>",
# comma-separated, secrets >= 32 chars. Generate one:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Keep OLD keys listed after a rotation. Every ciphertext names the key it was
# written under, so removing a key that some row still uses makes that row
# permanently unreadable.
ENCRYPTION_KEYS=1:CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# New credentials are written under this id; old ones still decrypt under theirs.
ENCRYPTION_ACTIVE_KEY_ID=1

EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768

# Leave blank if tesseract.exe is on PATH
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_MIN_CHARS_PER_PAGE=50

# --- LLM provider ---
# There is no GEMINI_API_KEY here any more. The active provider is a row in the
# `llm_providers` table, managed at /super-admin/llm-providers, and there is no
# environment fallback — a fallback would let this host answer from a stale key
# that nothing in the UI mentions.
#
# UPGRADING an existing install: set GEMINI_API_KEY and GEMINI_MODEL in your
# .env one last time and run `alembic upgrade head`. The migration encrypts the
# key into the table and makes it the active provider; you can delete both
# variables afterwards. On a fresh install, register a provider in the UI.
#
# How long a cached configuration may keep answering after the database stops
# being readable. Below this, availability wins; above it, safety.
LLM_CONFIG_STALENESS_SECONDS=300

STORAGE_BACKEND=local
STORAGE_ROOT=./storage

MAX_DOCUMENT_SIZE_MB=20
MAX_IMAGE_SIZE_MB=2
MAX_FILES_PER_BATCH=20

CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

DELETE_DUPLICATE_SOURCE_FILE=true
SEMANTIC_DUPLICATE_ENABLED=false
SEMANTIC_DUPLICATE_THRESHOLD=0.95

CHAT_CONTEXT_TURNS=6
CHAT_CONTEXT_TTL_SECONDS=86400

# --- Document management (Phase 5) ---
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
# Soft delete keeps the row so citations resolve. Keeping the blob too means a
# deletion is recoverable; turn this on only when storage cost outweighs that.
DELETE_SOURCE_FILE_ON_DELETE=false

# --- Rate limits (§40) ---
# "<count>/<window>". A bare count is rejected at startup rather than being
# read as per-minute. Windows: second, minute, hour, day.
# Login is per-IP; the rest are per-user.
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_DEFAULT=300/minute

LOG_LEVEL=INFO
LOG_JSON=true
